{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/agent-permission-profile-v1.json",
  "title": "dpone agent permission profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "last_reviewed", "purpose", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "owner": {"type": "string", "minLength": 1},
    "last_reviewed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "purpose": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "applies_to",
          "description",
          "sandbox_modes",
          "allowed_tools",
          "forbidden_tools",
          "protected_actions",
          "evidence_required",
          "escalation"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "owner": {"type": "string", "minLength": 1},
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "description": {"type": "string", "minLength": 1},
          "sandbox_modes": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["read-only", "workspace-write", "danger-full-access"]},
            "uniqueItems": true
          },
          "allowed_tools": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "forbidden_tools": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "protected_actions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "escalation": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
