{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/agent-governance-drift-summary-v1.json",
  "title": "dpone agent governance drift summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overall_status",
    "status",
    "components",
    "errors",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "overall_status": {"enum": ["passed", "failed", "unverified"]},
    "status": {"enum": ["passed", "failed", "unverified"]},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_security",
        "ruleset_drift",
        "classic_branch_protection"
      ],
      "properties": {
        "workflow_security": {"$ref": "#/$defs/component"},
        "ruleset_drift": {"$ref": "#/$defs/component"},
        "classic_branch_protection": {"$ref": "#/$defs/component"}
      }
    },
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors", "warnings"],
      "properties": {
        "status": {"enum": ["passed", "failed", "unverified"]},
        "errors": {
          "type": "array",
          "items": {"type": "string"}
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
