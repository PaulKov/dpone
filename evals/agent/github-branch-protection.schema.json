{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/github-branch-protection-v1.json",
  "title": "dpone GitHub branch protection policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "last_reviewed", "mode", "purpose", "ruleset", "owner_attestation"],
  "properties": {
    "schema_version": {"const": 1},
    "owner": {"type": "string", "minLength": 1},
    "last_reviewed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "mode": {"enum": ["solo_maintainer", "multi_reviewer"]},
    "purpose": {"type": "string", "minLength": 1},
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version_id",
        "updated_at",
        "name",
        "target",
        "enforcement",
        "conditions",
        "branches",
        "pull_request",
        "required_status_checks",
        "protected_actions",
        "bypass"
      ],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "version_id": {"type": "integer", "minimum": 1},
        "updated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "name": {"type": "string", "minLength": 1},
        "target": {"enum": ["branch"]},
        "enforcement": {"const": "active"},
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude"],
          "properties": {
            "include": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "exclude": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "pull_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "allowed_merge_methods",
            "dismiss_stale_reviews_on_push",
            "require_code_owner_review",
            "require_last_push_approval",
            "require_extra_approval_for_unattributed_changes",
            "required_approving_review_count",
            "required_review_thread_resolution",
            "required_reviewers"
          ],
          "properties": {
            "required": {"type": "boolean"},
            "allowed_merge_methods": {
              "type": "array",
              "minItems": 1,
              "items": {"enum": ["merge", "squash", "rebase"]},
              "uniqueItems": true
            },
            "dismiss_stale_reviews_on_push": {"type": "boolean"},
            "require_code_owner_review": {"type": "boolean"},
            "require_last_push_approval": {"type": "boolean"},
            "require_extra_approval_for_unattributed_changes": {"type": "boolean"},
            "required_approving_review_count": {"type": "integer", "minimum": 0},
            "required_review_thread_resolution": {"type": "boolean"},
            "required_reviewers": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "required_status_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strict", "do_not_enforce_on_create", "integration_id", "checks"],
          "properties": {
            "strict": {"type": "boolean"},
            "do_not_enforce_on_create": {"type": "boolean"},
            "integration_id": {"type": "integer", "minimum": 1},
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        },
        "protected_actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["block_deletion", "block_force_push"],
          "properties": {
            "block_deletion": {"type": "boolean"},
            "block_force_push": {"type": "boolean"}
          }
        },
        "bypass": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_repository_roles", "actors", "disallowed_for"],
          "properties": {
            "allowed_repository_roles": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "actors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["actor_id", "actor_type", "bypass_mode"],
                "properties": {
                  "actor_id": {"type": "integer", "minimum": 1},
                  "actor_type": {"type": "string", "minLength": 1},
                  "bypass_mode": {"type": "string", "minLength": 1}
                }
              }
            },
            "disallowed_for": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "owner_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_when_no_independent_reviewer", "evidence_required"],
      "properties": {
        "required_when_no_independent_reviewer": {"type": "boolean"},
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
