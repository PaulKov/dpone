{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dpone:workflow-security-policy:v1",
  "type": "object",
  "required": [
    "schema_version",
    "owner",
    "last_reviewed",
    "purpose",
    "required_controls",
    "allowed_workflow_write_permissions",
    "required_audit_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "required_controls": {
      "type": "object",
      "required": [
        "forbid_pull_request_target",
        "require_top_level_permissions",
        "require_pinned_external_actions",
        "forbid_pr_workflow_secrets",
        "require_audit_artifact_retention",
        "require_hidden_ci_artifact_transport",
        "isolate_dbt_execution_from_oidc",
        "require_platform_owned_prod_trust_policy"
      ],
      "properties": {
        "forbid_pull_request_target": {
          "const": true
        },
        "require_top_level_permissions": {
          "const": true
        },
        "require_pinned_external_actions": {
          "const": true
        },
        "forbid_pr_workflow_secrets": {
          "const": true
        },
        "require_audit_artifact_retention": {
          "const": true
        },
        "require_hidden_ci_artifact_transport": {
          "const": true
        },
        "isolate_dbt_execution_from_oidc": {
          "const": true
        },
        "require_platform_owned_prod_trust_policy": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "allowed_workflow_write_permissions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[^/]+\\.ya?ml$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "permissions",
              "reason"
            ],
            "properties": {
              "permissions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "actions",
                    "artifact-metadata",
                    "attestations",
                    "checks",
                    "code-quality",
                    "contents",
                    "deployments",
                    "discussions",
                    "id-token",
                    "issues",
                    "models",
                    "packages",
                    "pages",
                    "pull-requests",
                    "security-events",
                    "statuses",
                    "vulnerability-alerts"
                  ]
                }
              },
              "reason": {
                "type": "string",
                "minLength": 20
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "jobs",
              "reason"
            ],
            "properties": {
              "jobs": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "actions",
                      "artifact-metadata",
                      "attestations",
                      "checks",
                      "code-quality",
                      "contents",
                      "deployments",
                      "discussions",
                      "id-token",
                      "issues",
                      "models",
                      "packages",
                      "pages",
                      "pull-requests",
                      "security-events",
                      "statuses",
                      "vulnerability-alerts"
                    ]
                  }
                }
              },
              "reason": {
                "type": "string",
                "minLength": 20
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "required_audit_artifacts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[^/]+\\.ya?ml$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "retention_days",
            "reason"
          ],
          "properties": {
            "retention_days": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string",
              "minLength": 20
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
