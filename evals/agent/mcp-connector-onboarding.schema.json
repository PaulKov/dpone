{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/mcp-connector-onboarding-v1.json",
  "title": "dpone MCP connector onboarding policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "last_reviewed", "purpose", "required_controls", "connectors"],
  "properties": {
    "schema_version": {"const": 1},
    "owner": {"type": "string", "minLength": 1},
    "last_reviewed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "purpose": {"type": "string", "minLength": 1},
    "required_controls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "connectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "description",
          "tool_registry_id",
          "connector_kind",
          "status",
          "data_classification",
          "tenant_boundary",
          "token_storage",
          "allowed_profiles",
          "allowed_operations",
          "denied_operations",
          "allowed_scopes",
          "approval_required_for",
          "evidence_required",
          "required_controls",
          "red_team_scenarios"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "owner": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "tool_registry_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "connector_kind": {
            "enum": [
              "codex_connector",
              "document_session",
              "generic_mcp_connector",
              "local_mcp_server",
              "remote_mcp_server"
            ]
          },
          "status": {"enum": ["approved", "blocked", "deprecated"]},
          "data_classification": {"type": "string", "minLength": 1},
          "tenant_boundary": {"type": "string", "minLength": 1},
          "token_storage": {"type": "string", "minLength": 1},
          "allowed_profiles": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
            "uniqueItems": true
          },
          "allowed_operations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "denied_operations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "allowed_scopes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "approval_required_for": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "required_controls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "red_team_scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
