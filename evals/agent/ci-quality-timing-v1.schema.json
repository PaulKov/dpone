{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dpone:ci-quality-timing:v1",
  "title": "dpone exact-head CI quality timing evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "workflow_path",
    "workflow_sha256",
    "run_id",
    "run_attempt",
    "head_sha",
    "python_version",
    "status",
    "critical_path_seconds",
    "collection",
    "coverage"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "minLength": 1},
    "workflow_path": {"const": ".github/workflows/ci.yml"},
    "workflow_sha256": {"$ref": "#/$defs/sha"},
    "run_id": {"type": "integer", "minimum": 1},
    "run_attempt": {"type": "integer", "minimum": 1},
    "head_sha": {"$ref": "#/$defs/gitSha"},
    "python_version": {"enum": ["3.11", "3.12"]},
    "status": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
    "critical_path_seconds": {"type": "number", "minimum": 0},
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_count", "population_sha256", "shard_count"],
      "properties": {
        "node_count": {"type": "integer", "minimum": 1},
        "population_sha256": {"$ref": "#/$defs/sha"},
        "shard_count": {"type": "integer", "minimum": 1}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_sha256", "input_artifacts", "ratchet_status"],
      "properties": {
        "config_sha256": {"$ref": "#/$defs/sha"},
        "input_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "ratchet_status": {"enum": ["PASS", "FAIL", "UNVERIFIED"]}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {"name": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}
    }
  }
}
