{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/agent-tool-registry-v1.json",
  "title": "dpone agent tool registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "last_reviewed", "purpose", "tools"],
  "properties": {
    "schema_version": {"const": 1},
    "owner": {"type": "string", "minLength": 1},
    "last_reviewed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "purpose": {"type": "string", "minLength": 1},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "description",
          "category",
          "provenance",
          "risk_tier",
          "allowed_profiles",
          "allowed_actions",
          "forbidden_actions",
          "approval_required_for",
          "evidence_required"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "owner": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "category": {
            "enum": ["filesystem", "shell", "git", "github", "network", "mcp", "validation"]
          },
          "provenance": {"type": "string", "minLength": 1},
          "risk_tier": {"enum": ["low", "medium", "high", "critical"]},
          "allowed_profiles": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
            "uniqueItems": true
          },
          "allowed_actions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "forbidden_actions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "approval_required_for": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "allowed_scopes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
