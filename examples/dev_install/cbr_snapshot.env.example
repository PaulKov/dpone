# CBR public smoke via snapshot overlay install
DPONE_INSTALL_MODE=snapshot
DPONE_PACKAGE_SPEC=dpone==1.4.3.dev8123
DPONE_PACKAGE_INDEX_URL=https://<token>@gitlab.example.com/api/v4/projects/<project_id>/packages/pypi/simple
DPONE_PACKAGE_TARGET=/opt/dpone-runtime

# dpone config
DPONE_PROJECT_DIR=/opt/airflow/dags/repo
ENV_CODE=dev

# CBR smoke settings
DPONE_IT_CBR_RESOURCE=xml_daily_asp
DPONE_IT_CBR_DAYS_BACK=3
DPONE_IT_CBR_SELECTORS=app.xml_daily_asp
