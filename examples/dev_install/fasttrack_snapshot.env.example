# Fasttrack live smoke via snapshot overlay install
DPONE_INSTALL_MODE=snapshot
DPONE_PACKAGE_SPEC=dpone[vault,gcp]==1.4.3.dev8123
DPONE_PACKAGE_INDEX_URL=https://<token>@gitlab.example.com/api/v4/projects/<project_id>/packages/pypi/simple
DPONE_PACKAGE_EXTRA_INDEX_URL=https://pypi.org/simple
DPONE_PACKAGE_EXTRA_INDEX_URLS=https://pypi.org/simple
DPONE_PACKAGE_TARGET=/opt/dpone-runtime

# dpone config
DPONE_PROJECT_DIR=/opt/airflow/dags/repo
ENV_CODE=dev
DPONE_PARSE_TEMPORAL_FIELDS_DEFAULT=true

# Fasttrack live smoke settings
DPONE_IT_FT_VAULT_PATH=api/fasttrack
DPONE_IT_FT_RESOURCE=flex_cms_ratings
DPONE_IT_FT_SELECTORS=default.flex_cms_ratings
DPONE_IT_FT_TIMEOUT=60
DPONE_IT_FT_MAX_RETRIES=2
DPONE_IT_FT_RATE_LIMIT_DELAY=0.2
DPONE_IT_FT_PAGE_SIZE=1000

# Optional request filters
# DPONE_IT_FT_DASHBOARD_UUID=<uuid>
# DPONE_IT_FT_CATEGORY=<category>
# DPONE_IT_FT_LIMIT=100
# DPONE_IT_FT_OFFSET=0
