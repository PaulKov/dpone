# Mindbox live smoke via snapshot overlay install
DPONE_INSTALL_MODE=snapshot
DPONE_PACKAGE_SPEC=dpone[vault,gcp]==1.4.3.dev8123
DPONE_PACKAGE_INDEX_URL=https://<token>@gitlab.example.com/api/v4/projects/<project_id>/packages/pypi/simple
DPONE_PACKAGE_EXTRA_INDEX_URL=https://pypi.org/simple
DPONE_PACKAGE_EXTRA_INDEX_URLS=https://pypi.org/simple
DPONE_PACKAGE_TARGET=/opt/dpone-runtime

# dpone config
DPONE_PROJECT_DIR=/opt/airflow/dags/repo
ENV_CODE=dev

# Mindbox live smoke settings
DPONE_IT_MB_VAULT_PATH=api/mindbox
DPONE_IT_MB_RESOURCE=getactions
DPONE_IT_MB_SELECTORS=app.getactions
DPONE_IT_MB_DAYS_BACK=1
# Optional explicit UTC window; if both are empty, default is yesterday 12:00-13:00 UTC
DPONE_IT_MB_SINCE_DATETIME_UTC=  # default: yesterday 12:00:00Z
DPONE_IT_MB_TILL_DATETIME_UTC=   # default: yesterday 13:00:00Z
DPONE_IT_MB_POLL_INTERVAL=30
DPONE_IT_MB_EXPORT_TIMEOUT=3000
DPONE_IT_MB_BATCH_SIZE=1000
DPONE_IT_MB_UTC_BOUNDARY_TIME=21:00:00
