DPONE_PACKAGE_SPEC=dpone[vault,gcp]==1.4.3.dev8123
DPONE_PACKAGE_INDEX_URL=https://<user>:<token>@gitlab.example.com/api/v4/projects/<project_id>/packages/pypi/simple
DPONE_PACKAGE_EXTRA_INDEX_URL=https://pypi.org/simple
DPONE_PACKAGE_EXTRA_INDEX_URLS=https://pypi.org/simple
DPONE_PACKAGE_TARGET=/tmp/dpone-runtime-site
DPONE_PROJECT_DIR=/path/to/dpone
ENV_CODE=dev
VAULT_ADDR=https://vault.example.com
VAULT_AUTH_METHOD=jwt
VAULT_ID_TOKEN=
VAULT_AUTH_ROLE_DEV=dpone-viewer-dev
DPONE_IT_OXR_VAULT_PATH=api/openexchangerates
DPONE_IT_OXR_SELECTORS=default.historical_rates_daily
DPONE_IT_OXR_SYMBOLS=ARS,RUB,EUR
DPONE_IT_OXR_DAYS_BACK=1
