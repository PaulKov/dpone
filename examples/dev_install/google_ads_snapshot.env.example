# Google Ads live smoke via snapshot overlay install
DPONE_INSTALL_MODE=snapshot
DPONE_PACKAGE_SPEC=dpone[vault,gcp,google_ads]==1.4.3.dev8123
DPONE_PACKAGE_INDEX_URL=https://<token>@gitlab.example.com/api/v4/projects/<project_id>/packages/pypi/simple
DPONE_PACKAGE_EXTRA_INDEX_URL=https://pypi.org/simple
DPONE_PACKAGE_EXTRA_INDEX_URLS=https://pypi.org/simple
DPONE_PACKAGE_TARGET=/opt/dpone-runtime

# dpone config
DPONE_PROJECT_DIR=/opt/airflow/dags/repo
ENV_CODE=dev

# Google Ads live smoke settings
DPONE_IT_GA_VAULT_PATH=api/google_ads
DPONE_IT_GA_RESOURCE=ads_stats
DPONE_IT_GA_SELECTORS=app.ads_stats
DPONE_IT_GA_DAYS_BACK=3
DPONE_IT_GA_TIMEOUT=60
DPONE_IT_GA_MAX_RETRIES=1
DPONE_IT_GA_RATE_LIMIT_DELAY=1.0

# Optional explicit overrides
# DPONE_IT_GA_CUSTOMER_IDS=1234567890
# DPONE_IT_GA_DATE_FROM=2026-03-01
# DPONE_IT_GA_DATE_TO=2026-03-03
