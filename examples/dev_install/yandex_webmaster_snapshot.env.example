# Yandex Webmaster live smoke via snapshot overlay install
DPONE_INSTALL_MODE=snapshot
DPONE_PACKAGE_SPEC=dpone[vault,gcp]==1.4.3.dev8123
DPONE_PACKAGE_INDEX_URL=https://<token>@gitlab.example.com/api/v4/projects/<project_id>/packages/pypi/simple
DPONE_PACKAGE_EXTRA_INDEX_URL=https://pypi.org/simple
DPONE_PACKAGE_EXTRA_INDEX_URLS=https://pypi.org/simple
DPONE_PACKAGE_TARGET=/opt/dpone-runtime

# dpone config
DPONE_PROJECT_DIR=/opt/airflow/dags/repo
ENV_CODE=dev

# Yandex Webmaster live smoke settings
DPONE_IT_YANDEX_WEBMASTER_VAULT_PATH=api/yandex_webmaster
DPONE_IT_YANDEX_WEBMASTER_HOST_ID=https:travel.example.com:443
# DPONE_IT_YANDEX_WEBMASTER_HOST_URL=https://travel.example.com
DPONE_IT_YANDEX_WEBMASTER_RESOURCE=host_metrics_daily
DPONE_IT_YANDEX_WEBMASTER_SELECTORS=app.host_metrics_daily
DPONE_IT_YANDEX_WEBMASTER_DAYS_BACK=3
DPONE_IT_YANDEX_WEBMASTER_TIMEOUT=60
DPONE_IT_YANDEX_WEBMASTER_MAX_RETRIES=1
DPONE_IT_YANDEX_WEBMASTER_RATE_LIMIT_DELAY=0.5
DPONE_IT_YANDEX_WEBMASTER_PAGES_IN_SEARCH_DAILY_AGG=last

# Optional explicit window / host overrides
# DPONE_IT_YANDEX_WEBMASTER_USER_ID=42
# DPONE_IT_YANDEX_WEBMASTER_HOST_URL=https://example.com
# DPONE_IT_YANDEX_WEBMASTER_DEVICE_TYPES=DESKTOP,MOBILE,TABLET
# DPONE_IT_YANDEX_WEBMASTER_REGION_IDS=225,1,10174
# DPONE_IT_YANDEX_WEBMASTER_DAY=2026-03-17
# DPONE_IT_YANDEX_WEBMASTER_DATE_FROM=2026-03-15
# DPONE_IT_YANDEX_WEBMASTER_DATE_TO=2026-03-17
