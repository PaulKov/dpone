# Google Sheets live smoke via snapshot overlay install
DPONE_INSTALL_MODE=snapshot
DPONE_PACKAGE_SPEC=dpone[vault,gcp]==1.4.3.dev8123
DPONE_PACKAGE_INDEX_URL=https://<token>@gitlab.example.com/api/v4/projects/<project_id>/packages/pypi/simple
DPONE_PACKAGE_EXTRA_INDEX_URL=https://pypi.org/simple
DPONE_PACKAGE_EXTRA_INDEX_URLS=https://pypi.org/simple
DPONE_PACKAGE_TARGET=/opt/dpone-runtime

# dpone config
DPONE_PROJECT_DIR=/opt/airflow/dags/repo
ENV_CODE=dev

# Google Sheets live smoke settings
DPONE_IT_GS_VAULT_PATH=api/google_sheets
DPONE_IT_GS_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1EXAMPLE1234567890/edit#gid=0
DPONE_IT_GS_RESOURCE=worksheet_rows
DPONE_IT_GS_SELECTORS=app.worksheet_rows
DPONE_IT_GS_HEADER_ROW=1
DPONE_IT_GS_SKIP_ROWS=0
DPONE_IT_GS_ADD_METADATA_COLUMNS=1
DPONE_IT_GS_TIMEOUT=60
DPONE_IT_GS_MAX_RETRIES=1
DPONE_IT_GS_RATE_LIMIT_DELAY=0.2

# Optional worksheet targeting
# DPONE_IT_GS_WORKSHEET_TITLE=Sheet1
# DPONE_IT_GS_WORKSHEET_INDEX=0
# DPONE_IT_GS_RANGE_NAME=A1:Z100
