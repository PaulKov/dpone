{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/data-product/data-product-slo-gate.schema.json",
  "title": "dpone data product SLO gate",
  "type": "object",
  "required": ["schema_version", "slo_gate_id", "status", "profile", "blockers", "warnings"],
  "properties": {
    "schema_version": {"const": "dpone.data_product_slo_gate.v1"},
    "slo_gate_id": {"type": "string"},
    "status": {"enum": ["allowed", "warning", "blocked"]},
    "profile": {"enum": ["advisory", "stage", "prod_strict", "regulated"]},
    "product_id": {"type": ["string", "null"]},
    "slo_plan_id": {"type": ["string", "null"]},
    "slo_evaluation_id": {"type": ["string", "null"]},
    "pack_id": {"type": ["string", "null"]},
    "bundle_id": {"type": ["string", "null"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
