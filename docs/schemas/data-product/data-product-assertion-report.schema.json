{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/data-product/data-product-assertion-report.schema.json",
  "title": "dpone data product assertion report",
  "type": "object",
  "required": ["schema_version", "assertion_report_id", "status", "markdown", "blockers", "warnings"],
  "properties": {
    "schema_version": {"const": "dpone.data_product_assertion_report.v1"},
    "assertion_report_id": {"type": "string"},
    "status": {"type": ["string", "null"]},
    "product_id": {"type": ["string", "null"]},
    "assertion_evaluation_id": {"type": ["string", "null"]},
    "summary": {"type": "object"},
    "markdown": {"type": "string"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
