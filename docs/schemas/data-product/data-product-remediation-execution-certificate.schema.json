{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/data-product/data-product-remediation-execution-certificate.schema.json",
  "title": "Data Product Remediation Execution Certificate",
  "type": "object",
  "required": ["schema_version", "status", "remediation_execution_certificate_id", "evidence_refs"],
  "properties": {
    "schema_version": {
      "const": "dpone.data_product_remediation_execution_certificate.v1"
    },
    "status": {
      "enum": ["certified", "warning", "blocked"]
    },
    "remediation_execution_run_id": {
      "type": ["string", "null"]
    },
    "remediation_execution_certificate_id": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
