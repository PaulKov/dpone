{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/data-product/data-product-compliance-gate.schema.json",
  "title": "Data Product Compliance Gate",
  "type": "object",
  "required": ["schema_version", "status", "compliance_gate_id", "compliance_evaluation_id", "controls", "blockers", "warnings"],
  "properties": {
    "schema_version": {"const": "dpone.data_product_compliance_gate.v1"},
    "status": {"enum": ["allowed", "warning", "blocked"]},
    "compliance_gate_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compliance_evaluation_id": {"type": ["string", "null"]},
    "compliance_plan_id": {"type": ["string", "null"]},
    "profile": {"type": "string"},
    "product": {"type": "object"},
    "product_id": {"type": ["string", "null"]},
    "pack_id": {"type": ["string", "null"]},
    "bundle_id": {"type": ["string", "null"]},
    "controls": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
