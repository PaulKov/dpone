{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/data-product/data-product-audit-archive-run.schema.json",
  "title": "Data Product Audit Archive Run",
  "type": "object",
  "required": ["schema_version", "status", "audit_archive_run_id", "archive_uri", "blockers", "warnings"],
  "properties": {
    "schema_version": {"const": "dpone.data_product_audit_archive_run.v1"},
    "status": {"enum": ["dry_run", "archived", "blocked"]},
    "audit_archive_run_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "audit_archive_plan_id": {"type": ["string", "null"]},
    "audit_archive_id": {"type": "string"},
    "archive_uri": {"type": "string"},
    "artifact_count": {"type": "integer"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
