{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/schema-migration/evidence-registry.schema.json",
  "title": "dpone schema migration evidence registry",
  "type": "object",
  "required": ["schema_version", "record_count", "records"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "dpone.schema_migration_evidence_registry.v1"},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {
      "type": "array",
      "items": {"$ref": "evidence-registry-record.schema.json"}
    }
  }
}
