{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/schema-migration/rehearsal-plan.schema.json",
  "title": "dpone schema migration rehearsal plan",
  "type": "object",
  "required": [
    "schema_version",
    "rehearsal_plan_id",
    "status",
    "pack_id",
    "environment",
    "target",
    "operations",
    "rollback_operations",
    "checks",
    "blockers",
    "warnings"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "dpone.schema_migration_rehearsal_plan.v1"},
    "rehearsal_plan_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["planned", "blocked"]},
    "pack_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bundle_id": {"type": ["string", "null"]},
    "environment": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "required": ["sink_type", "table"],
      "additionalProperties": true,
      "properties": {
        "sink_type": {"type": "string"},
        "table": {"type": "string"}
      }
    },
    "target_connection": {"type": "object"},
    "operations": {"type": "array", "items": {"type": "object"}},
    "rollback_operations": {"type": "array", "items": {"type": "object"}},
    "checks": {"type": "array", "items": {"type": "object"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
