{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/schema-migration/watch-plan.schema.json",
  "title": "dpone schema migration release watch plan",
  "type": "object",
  "required": [
    "schema_version",
    "watch_plan_id",
    "pack_id",
    "post_apply_certificate_id",
    "environment",
    "target",
    "status",
    "window",
    "samples",
    "checks",
    "canaries",
    "blockers",
    "warnings"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "dpone.schema_migration_watch_plan.v1"},
    "watch_plan_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pack_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "post_apply_certificate_id": {"type": ["string", "null"]},
    "environment": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "required": ["sink_type", "table"],
      "additionalProperties": true,
      "properties": {
        "sink_type": {"type": "string"},
        "table": {"type": "string"}
      }
    },
    "status": {"enum": ["planned", "disabled", "blocked"]},
    "mode": {"enum": ["observe", "gate"]},
    "profile": {"enum": ["advisory", "stage", "prod_strict", "regulated"]},
    "window": {"type": "object"},
    "samples": {"type": "object"},
    "checks": {"type": "object"},
    "canaries": {"type": "array", "items": {"type": "object"}},
    "query_health": {"type": "object"},
    "remediation": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
