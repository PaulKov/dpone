{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/schema-migration/schema-contract-consumer-inventory.schema.json",
  "title": "dpone schema contract consumer inventory",
  "type": "object",
  "required": ["schema_version", "status", "contract_id", "consumers", "summary", "blockers", "warnings"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "dpone.schema_contract_consumer_inventory.v1"},
    "consumer_inventory_id": {"type": "string", "pattern": "^sha256:"},
    "status": {"enum": ["discovered", "blocked"]},
    "contract_id": {"type": "string"},
    "contract_version_id": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "source", "reads"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "owner": {"type": ["string", "null"]},
          "source": {"type": "string"},
          "version_constraint": {"type": ["string", "null"]},
          "reads": {"type": "object"},
          "confidence": {"enum": ["explicit", "parsed", "inferred", "table_only"]},
          "lineage_sources": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "summary": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
