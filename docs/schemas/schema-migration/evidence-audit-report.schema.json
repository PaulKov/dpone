{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/schema-migration/evidence-audit-report.schema.json",
  "title": "dpone schema migration evidence audit report",
  "type": "object",
  "required": ["schema_version", "audit_report_id", "target", "record_count", "pack_count", "records", "warnings", "markdown"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "dpone.schema_migration_evidence_audit_report.v1"},
    "audit_report_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target": {"type": ["string", "null"]},
    "date_from": {"type": ["string", "null"]},
    "date_to": {"type": ["string", "null"]},
    "record_count": {"type": "integer", "minimum": 0},
    "pack_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "markdown": {"type": "string"}
  }
}
