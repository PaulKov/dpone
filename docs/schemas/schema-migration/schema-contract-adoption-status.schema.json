{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/schema-migration/schema-contract-adoption-status.schema.json",
  "title": "Schema Contract Adoption Status",
  "type": "object",
  "required": ["schema_version", "status", "consumers", "summary", "blockers", "warnings"],
  "properties": {
    "schema_version": {"const": "dpone.schema_contract_adoption_status.v1"},
    "adoption_status_id": {"type": "string", "pattern": "^sha256:"},
    "status": {"enum": ["empty", "active", "migrated", "blocked"]},
    "contract_id": {"type": ["string", "null"]},
    "base_version": {"type": ["string", "null"]},
    "head_version": {"type": ["string", "null"]},
    "adoption_plan_id": {"type": ["string", "null"]},
    "consumer_matrix_id": {"type": ["string", "null"]},
    "compatibility_view_plan_id": {"type": ["string", "null"]},
    "consumers": {"type": "array", "items": {"type": "object"}},
    "summary": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
