{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/postgres-mssql-correctness-profiles.v1.schema.json",
  "title": "dpone PostgreSQL to MSSQL correctness profile catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profiles", "registrations"],
  "properties": {
    "schema": {
      "const": "dpone.postgres-mssql-correctness-profiles.v1"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1000,
      "propertyNames": {"$ref": "#/$defs/canonicalRef"},
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "registrations": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/registration"}
    }
  },
  "$defs": {
    "canonicalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,126}[A-Za-z0-9])?$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000]+$"
    },
    "positiveSqlBigint": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_connection_ref",
        "sink_connection_ref",
        "allowed_source_modes",
        "source_major",
        "target_major",
        "topology",
        "object_profile",
        "key_types",
        "receipt_contract",
        "hash_policy",
        "writer_fence",
        "session_count",
        "transaction_scope",
        "delayed_durability_disabled",
        "max_descendant_proof_receipts",
        "target_binding_uuid",
        "target_contract_revision",
        "quality_policy",
        "certification_ref"
      ],
      "properties": {
        "source_connection_ref": {"$ref": "#/$defs/canonicalRef"},
        "sink_connection_ref": {"$ref": "#/$defs/canonicalRef"},
        "allowed_source_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["batch_full_refresh", "xmin_current_state"]}
        },
        "source_major": {"const": 16},
        "target_major": {"const": 2022},
        "topology": {"const": "standalone_same_database"},
        "object_profile": {"const": "ordinary_disk_rowstore"},
        "key_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["int2", "int4", "int8", "uuid"]}
        },
        "receipt_contract": {"const": "mssql_effect_receipt_v2"},
        "hash_policy": {"const": "postgres_mssql_row_hash_v1"},
        "writer_fence": {"const": "mssql_target_head_v2"},
        "session_count": {"const": 1},
        "transaction_scope": {"const": "local_database"},
        "delayed_durability_disabled": {"const": true},
        "max_descendant_proof_receipts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "target_binding_uuid": {"type": "string", "format": "uuid"},
        "target_contract_revision": {"$ref": "#/$defs/positiveSqlBigint"},
        "quality_policy": {"$ref": "#/$defs/canonicalRef"},
        "certification_ref": {"$ref": "#/$defs/canonicalRef"}
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_connection_ref",
        "sink_connection_ref",
        "source_mode",
        "target_schema",
        "target_table",
        "profile_id"
      ],
      "properties": {
        "source_connection_ref": {"$ref": "#/$defs/canonicalRef"},
        "sink_connection_ref": {"$ref": "#/$defs/canonicalRef"},
        "source_mode": {"enum": ["batch_full_refresh", "xmin_current_state"]},
        "target_schema": {"$ref": "#/$defs/identifier"},
        "target_table": {"$ref": "#/$defs/identifier"},
        "profile_id": {"$ref": "#/$defs/canonicalRef"}
      }
    }
  }
}
