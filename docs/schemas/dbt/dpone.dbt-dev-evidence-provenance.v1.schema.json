{
  "$id": "https://dpone.dev/schemas/dpone.dbt-dev-evidence-provenance.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deployment_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "producer_repository": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "producer_workflow": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "release_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "dpone.dbt-dev-evidence-provenance.v1"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "release_id",
    "deployment_id",
    "producer_repository",
    "producer_workflow",
    "source_commit"
  ],
  "type": "object"
}
