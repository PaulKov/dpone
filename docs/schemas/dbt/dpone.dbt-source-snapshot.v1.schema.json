{
  "$id": "https://dpone.dev/schemas/dpone.dbt-source-snapshot.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "project_bundle_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "dpone.dbt-source-snapshot.v1"
    },
    "snapshot_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "project_bundle_sha256",
    "manifest_sha256",
    "snapshot_sha256"
  ],
  "type": "object"
}
