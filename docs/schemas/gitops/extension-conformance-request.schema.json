{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/gitops/extension-conformance-request.schema.json",
  "title": "dpone GitOps extension conformance request",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "subject",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "dpone.extension-conformance-request.v1"
    },
    "profile": {
      "enum": [
        "airflow_provider",
        "recipe_catalog",
        "credential_resolver",
        "route"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "check",
          "artifact_ref",
          "sha256",
          "expected_schema"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "expected_schema": {
            "enum": [
              "dpone.extension-check-receipt.v1",
              "dpone.catalog-bundle-verification.v1"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
