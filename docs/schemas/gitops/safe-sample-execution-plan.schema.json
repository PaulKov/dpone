{
  "$defs": {
    "artifact": {
      "additionalProperties": true,
      "properties": {
        "artifact_ref": {
          "pattern": "^cache://(?!(?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:/|$))(?![^\\s]*/(?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:/|$))[^\\s]+$",
          "type": "string"
        },
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "artifact_ref",
        "sha256",
        "bytes"
      ],
      "type": "object"
    },
    "error": {
      "additionalProperties": true,
      "properties": {
        "code": {
          "pattern": "^DPONE_[A-Z0-9_]+$",
          "type": "string"
        },
        "fixes": {
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "const": "dpone.error.v1"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "stage": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema",
        "code",
        "stage",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://paulkov.github.io/dpone/schemas/gitops/safe-sample-execution-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_pinning": {
      "additionalProperties": true,
      "properties": {
        "deployment_id": {
          "$ref": "#/$defs/sha256"
        },
        "pinned_workload_uri": {
          "pattern": "^cached://deployments/sha256:[0-9a-f]{64}/workloads/[^\\s/?]+$",
          "type": "string"
        },
        "release_id": {
          "$ref": "#/$defs/sha256"
        },
        "workload_packs": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "sha256"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/error"
      },
      "type": "array"
    },
    "deployment_context": {
      "additionalProperties": true,
      "properties": {
        "airflow_bundle_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "binding_set_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "connection_registry_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "credential_runtime_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "deployment_id": {
          "$ref": "#/$defs/sha256"
        },
        "deployment_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "deployment_type": {
          "minLength": 1,
          "type": "string"
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "index_path": {
          "minLength": 1,
          "type": "string"
        },
        "parse_side_effects": {
          "additionalProperties": {
            "type": "boolean"
          },
          "type": "object"
        },
        "release_id": {
          "$ref": "#/$defs/sha256"
        },
        "runnable": {
          "type": "boolean"
        },
        "runtime_artifact_delivery": {
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "init_fetch"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "artifact_registry_ref",
                  "identity",
                  "source",
                  "verify"
                ]
              }
            }
          ],
          "properties": {
            "artifact_registry_ref": {
              "pattern": "^(?!.*%)(?!(?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:$|[/:@?#=&]))(?!.*[/:@?#=&](?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:$|[/:@?#=&]))\\S+$",
              "type": "string"
            },
            "identity": {
              "additionalProperties": true,
              "properties": {
                "method": {
                  "enum": [
                    "kubernetes_workload_identity"
                  ]
                },
                "service_account": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "method",
                "service_account"
              ],
              "type": "object"
            },
            "mode": {
              "enum": [
                "local_preview",
                "init_fetch",
                "shared_pvc",
                "embedded_bundle",
                "csi_volume",
                "inline"
              ]
            },
            "registry_credentials": {
              "additionalProperties": false,
              "properties": {
                "connection_id": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "type": "string"
                },
                "method": {
                  "const": "airflow_connection_kubernetes_secret"
                },
                "secret_ref": {
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "maxLength": 253,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$",
                      "type": "string"
                    },
                    "name": {
                      "maxLength": 63,
                      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "key"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "method",
                "connection_id",
                "secret_ref"
              ],
              "type": "object"
            },
            "source": {
              "additionalProperties": true,
              "properties": {
                "artifact_registry_ref": {
                  "pattern": "^(?!.*%)(?!(?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:$|[/:@?#=&]))(?!.*[/:@?#=&](?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:$|[/:@?#=&]))\\S+$",
                  "type": "string"
                }
              },
              "required": [
                "artifact_registry_ref"
              ],
              "type": "object"
            },
            "verify": {
              "additionalProperties": true,
              "properties": {
                "attestations": {
                  "enum": [
                    "optional",
                    "required_for_prod"
                  ]
                },
                "checksums": {
                  "enum": [
                    "required"
                  ]
                }
              },
              "required": [
                "checksums",
                "attestations"
              ],
              "type": "object"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        "runtime_image_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "const": "dpone.safe-sample-airflow-deployment-context.v1"
        },
        "workload_packs": {
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "type": "array"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "environment": {
      "minLength": 1,
      "type": "string"
    },
    "policy_result": {
      "additionalProperties": true,
      "properties": {
        "capabilities": {
          "type": "object"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/error"
          },
          "type": "array"
        },
        "passed": {
          "type": "boolean"
        },
        "policy": {
          "type": "object"
        },
        "request": {
          "type": "object"
        }
      },
      "required": [
        "passed",
        "request",
        "policy",
        "capabilities",
        "errors"
      ],
      "type": "object"
    },
    "runnable": {
      "type": "boolean"
    },
    "sample_rows": {
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "const": "dpone.safe-sample-execution-plan.v1"
    },
    "source_snapshot": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)\\S+$",
          "type": "string"
        },
        "pipeline_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{1,127}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "pipeline_id",
        "path",
        "sha256"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "temporary_target_plan": {
      "additionalProperties": true,
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "sample_rows",
    "environment",
    "runnable",
    "policy_result",
    "artifact_pinning",
    "blockers"
  ],
  "title": "dpone GitOps safe sample execution plan",
  "type": "object"
}
