{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/gitops/extension-conformance.schema.json",
  "title": "dpone GitOps extension conformance",
  "type": "object",
  "required": [
    "schema",
    "conformance_id",
    "profile",
    "subject",
    "status",
    "checks",
    "evaluated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "dpone.extension-conformance.v1"
    },
    "conformance_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile": {
      "enum": [
        "airflow_provider",
        "recipe_catalog",
        "credential_resolver",
        "route"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1
    },
    "evaluated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
