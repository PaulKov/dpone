{
  "$defs": {
    "artifact": {
      "additionalProperties": true,
      "properties": {
        "artifact_ref": {
          "pattern": "^cache://(?!(?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:/|$))(?![^\\s]*/(?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:/|$))[^\\s]+$",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "artifact_ref",
        "sha256"
      ],
      "type": "object"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "type": "array"
    },
    "identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[A-Fa-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "https://paulkov.github.io/dpone/schemas/gitops/airflow-deployment-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "airflow_bundle_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding_set_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "connection_registry_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "credential_runtime_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "dag_specs": {
      "$ref": "#/$defs/artifacts"
    },
    "deployment_id": {
      "$ref": "#/$defs/identity"
    },
    "environment": {
      "type": "string"
    },
    "release_id": {
      "$ref": "#/$defs/identity"
    },
    "runtime_artifact_delivery": {
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "init_fetch"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "artifact_registry_ref",
              "identity",
              "source",
              "verify"
            ]
          }
        }
      ],
      "properties": {
        "artifact_registry_ref": {
          "pattern": "^(?!.*%)(?!(?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:$|[/:@?#=&]))(?!.*[/:@?#=&](?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:$|[/:@?#=&]))\\S+$",
          "type": "string"
        },
        "identity": {
          "additionalProperties": true,
          "properties": {
            "method": {
              "enum": [
                "kubernetes_workload_identity"
              ]
            },
            "service_account": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "method",
            "service_account"
          ],
          "type": "object"
        },
        "mode": {
          "enum": [
            "local_preview",
            "init_fetch",
            "shared_pvc",
            "embedded_bundle",
            "csi_volume",
            "inline"
          ]
        },
        "registry_credentials": {
          "additionalProperties": false,
          "properties": {
            "connection_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            "method": {
              "const": "airflow_connection_kubernetes_secret"
            },
            "secret_ref": {
              "additionalProperties": false,
              "properties": {
                "key": {
                  "maxLength": 253,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$",
                  "type": "string"
                },
                "name": {
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "key"
              ],
              "type": "object"
            }
          },
          "required": [
            "method",
            "connection_id",
            "secret_ref"
          ],
          "type": "object"
        },
        "source": {
          "additionalProperties": true,
          "properties": {
            "artifact_registry_ref": {
              "pattern": "^(?!.*%)(?!(?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:$|[/:@?#=&]))(?!.*[/:@?#=&](?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt])(?:$|[/:@?#=&]))\\S+$",
              "type": "string"
            }
          },
          "required": [
            "artifact_registry_ref"
          ],
          "type": "object"
        },
        "verify": {
          "additionalProperties": true,
          "properties": {
            "attestations": {
              "enum": [
                "optional",
                "required_for_prod"
              ]
            },
            "checksums": {
              "enum": [
                "required"
              ]
            }
          },
          "required": [
            "checksums",
            "attestations"
          ],
          "type": "object"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "runtime_image_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "const": "dpone.airflow-deployment-index.v1"
    },
    "workload_packs": {
      "$ref": "#/$defs/artifacts"
    }
  },
  "required": [
    "schema",
    "release_id",
    "deployment_id",
    "dag_specs",
    "workload_packs",
    "runtime_artifact_delivery"
  ],
  "title": "dpone GitOps Airflow deployment index",
  "type": "object"
}
