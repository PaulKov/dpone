{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.local/schemas/dpone.scaffold-rollback-journal.v1.json",
  "title": "dpone scaffold rollback journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": { "const": "dpone.scaffold-rollback-journal.v1" },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "path"],
            "properties": {
              "action": { "const": "delete" },
              "path": {
                "type": "string",
                "minLength": 1,
                "not": { "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))" }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "kind", "path", "device", "inode", "require_empty"],
            "properties": {
              "action": { "const": "verify_and_remove" },
              "kind": { "enum": ["file", "directory"] },
              "path": {
                "type": "string",
                "minLength": 1,
                "not": { "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))" }
              },
              "device": { "type": "integer", "minimum": 0 },
              "inode": { "type": "integer", "minimum": 0 },
              "require_empty": { "type": "boolean" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "kind": { "const": "directory" } },
                  "required": ["kind"]
                },
                "then": {
                  "properties": { "require_empty": { "const": true } }
                },
                "else": {
                  "properties": { "require_empty": { "const": false } }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
