{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/release/release-public-bundle-v2.schema.json",
  "title": "dpone release public bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "candidate_id", "manifest_sha256", "distributions", "asset_names"],
  "properties": {
    "schema": { "const": "dpone.release-public-bundle.v2" },
    "schema_version": { "const": 2 },
    "candidate_id": { "$ref": "#/$defs/sha256Id" },
    "manifest_sha256": { "$ref": "#/$defs/sha256Id" },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "filename", "size", "sha256"],
        "properties": {
          "project": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "asset_names": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256Id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
