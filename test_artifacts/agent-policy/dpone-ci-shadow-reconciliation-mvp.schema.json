        "inside_interval_missing_from_producer_query": {"const": {"outcome": "UNVERIFIED", "code": "RECONCILIATION_PRODUCER_QUERY_OMISSION", "affects_current_root": true, "recovery": "RECONCILIATION_RETRY"}},
        "missing_foreign_or_unresolvable": {"const": {"outcome": "UNVERIFIED", "code": "RECONCILIATION_PRODUCER_IDENTITY_UNRESOLVABLE", "affects_current_root": true, "recovery": "VERIFY_PRODUCER_IDENTITY_OR_CREATE_NEW_RUN"}},
