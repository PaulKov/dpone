        "report_observation_boundary": {"const": "completion of the second matching whole-tree observation"},
        "provider_reads_after_boundary": {"const": false},
        "enumerate_all_run_attempts": {"const": true},
        "same_second_overflow": {"const": "UNVERIFIED"},
        "incomplete_pagination": {"const": "UNVERIFIED"}
      }
