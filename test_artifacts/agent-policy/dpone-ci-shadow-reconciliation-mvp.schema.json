      "type": "object",
      "additionalProperties": false,
      "required": ["producer_timestamp_authority", "exact_producer_run_lookup_required", "before_scan_from", "inside_interval", "after_safe_through_not_after_observation_start", "after_observation_start", "inside_interval_missing_from_producer_query", "missing_foreign_or_unresolvable", "report_every_classification"],
      "properties": {
