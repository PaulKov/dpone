    "request_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["increment", "includes", "redirect_rule", "response_byte_rule", "retry_rule", "request_class_conservation", "counter_semantics", "wall_time_scope", "dispatch_timeout_rule"],
      "properties": {
        "increment": {"const": "before every outbound HTTP dispatch"},
        "includes": {"const": "REST, Git object, pull-request identity, artifact download endpoint, redirect follow-up, polling, and retry dispatches"},
