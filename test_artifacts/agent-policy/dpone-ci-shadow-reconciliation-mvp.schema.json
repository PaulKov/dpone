        "schema_path": {"const": "test_artifacts/agent-policy/dpone-ci-shadow-reconciliation-capacity.schema.json"},
        "artifact_name": {"const": "pr-gate-shadow-reconciliation-capacity-<observer_run_id>-<observer_run_attempt>.json"},
        "artifact_max_bytes": {"const": 8388608},
        "decision": {"const": "UNVERIFIED"},
        "code": {"const": "RECONCILIATION_CAPACITY_CALIBRATION_ONLY"},
        "observation_bundle_digest_required": {"const": true},
        "observation_bundle_manifest_schema": {"const": "dpone.ci-shadow-reconciliation-observation-bundle.v1"},
        "observation_bundle_domain": {"const": "dpone.ci-shadow-reconciliation-observation-bundle.v1"},
        "observation_bundle_closure": {"const": "capacity workflow, CLI composition root, shared canonical acquisition service, policy, ports, adapters, their transitive local imports/reads/called scripts, pyproject.toml, uv.lock, and the separately hashed manifest"},
        "wrapper_source_bound_separately": {"const": false},
        "execution_configuration_must_match": {"const": true},
        "observation_bundle_entry_order": {"const": "strict ascending UTF-8 repo-relative path bytes; duplicates forbidden"},
        "observation_bundle_entry_bytes": {"const": "u32be(path length) || path UTF-8 || six ASCII mode bytes || raw 32-byte SHA-256"},
        "observation_bundle_digest_rule": {"const": "SHA256(domain UTF-8 || 0x00 || u64be(manifest length) || u32be(entry count) || repeated u32be(entry length) || entry bytes || raw 32-byte manifest SHA-256)"},
        "observation_bundle_reject": {"const": "absolute/dot-dot/non-UTF-8 paths, symlinks, dynamic or unresolved local imports/reads/called scripts"},
        "observation_bundle_max_entries": {"const": 4096},
        "observation_bundle_max_path_utf8_bytes": {"const": 1024},
        "reconciler_bundle_must_match": {"const": true},
        "history_window_days": {"const": 14},
        "complete_double_observation_required": {"const": true},
        "current_observation_rule": {"const": "0 <= evidence_observed_through - observation_started_at <= calibration_observed_at - observation_started_at <= 900 seconds"},
        "maximum_age_hours_at_limit_approval": {"const": 24},
        "approval_expiry_rule": {"const": "approval_time must be greater than or equal to calibration_observed_at and strictly less than valid_until"},
        "provider_transport_binding": {"const": "select exact repository/run/attempt/artifact ID/name, reject provider ZIP archive size above 8388608 before a max+1 archive read, verify archive length and SHA256 against provider size/digest, then accept exactly one expected confined regular JSON member with separate bounded payload SHA256/size before duplicate-free/non-finite strict-parse at depth 32 and 50000 nodes; reject duplicate/extra/directory/symlink/encrypted/traversal/unsupported-compression entries"},
        "crossed_counter_rule": {"const": "limits_crossed is in hard-maxima order and each named counter equals its saturated hard maximum; retry_requests is at most total_http_requests"},
        "required_fields": {"const": ["producer_runs", "producer_attempts", "auditor_runs", "producer_list_page_requests", "auditor_list_page_requests", "exact_producer_run_requests", "attempt_run_requests", "jobs_page_requests", "artifact_metadata_requests", "artifact_download_requests", "redirect_requests", "git_object_requests", "pull_request_identity_requests", "polling_requests", "retry_requests", "api_response_body_bytes", "artifact_download_body_bytes", "total_response_body_bytes", "total_http_requests", "execution_wall_seconds"]},
        "minimum_safety_factor": {"const": 2},
        "hard_maxima": {"const": {"total_http_requests": 800, "total_response_body_bytes": 134217728, "execution_wall_seconds": 900}},
        "approval_thresholds": {"const": {"total_http_requests": 400, "total_response_body_bytes": 67108864, "execution_wall_seconds": 450}},
        "approval_rule": {"const": "complete observed request, response-byte, and wall-time usage must each be at most half the parent hard maximum"},
        "failure": {"const": "RECONCILIATION_PR4C_IMPLEMENTATION_BLOCKED"},
        "amendment_rule": {"const": "exceeding a threshold requires an approved parent amendment; a child cannot raise a hard maximum"}
      }
