        "max_raw_artifact_records": {"const": 65536},
        "max_response_bytes": {"const": 134217728},
        "response_byte_scope": {"const": "API response bodies plus downloaded artifact bytes across both observations"},
        "max_wall_seconds": {"const": 900},
        "max_producer_attempts": {"const": 4096},
        "max_auditor_receipts": {"const": 4096},
