        "response_byte_rule": {"const": "count response-body octets delivered to the application before archive decompression"},
        "retry_rule": {"const": "each retry increments total_http_requests and its functional request class"},
        "request_class_conservation": {"const": "total_http_requests equals the sum of all dispatch classes except retry_requests, which is an intersecting subset"},
        "counter_semantics": {"const": "exact below limits; saturating lower bounds at a crossed hard limit"},
        "wall_time_scope": {"const": "injected monotonic seconds from immediately before first provider dispatch through final observation evaluation"},
        "dispatch_timeout_rule": {"const": "min(adapter timeout, remaining wall budget); do not dispatch when no budget remains"}
      }
