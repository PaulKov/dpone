        "exact_expires_minus_created_required": {"const": false},
        "missing_or_expired": {"const": "UNVERIFIED"},
        "window_history_loss": {"const": "RECONCILIATION_RETENTION_HISTORY_LOST"},
        "current_head_recovery": {"const": "a fresh auditable attempt may establish new exact-head evidence but never repairs an overlapping daily interval"},
        "daily_root_recovery": {"const": "wait until the lost attempt leaves a later complete clean window; never relabel an old report"}
      }
