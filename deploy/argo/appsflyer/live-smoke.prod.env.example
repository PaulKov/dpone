# Manual / live smoke in prod-like environment
DPONE_INSTALL_MODE=baked
DPONE_PACKAGE_TARGET=/opt/dpone-runtime
DPONE_PROJECT_DIR=/opt/airflow/dags/repo
ENV_CODE=prod

DPONE_IT_AF_VAULT_PATH=api/appsflyer
DPONE_IT_AF_APP_IDS=com.example.travel,id1234567890
DPONE_IT_AF_SELECTORS=app.installs_report
DPONE_IT_AF_DAYS_BACK=2
DPONE_IT_AF_TIMEZONE=Europe/Moscow
DPONE_IT_AF_MAXIMUM_ROWS=10000
