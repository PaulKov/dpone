# Manual / live smoke in prod-like environment
DPONE_INSTALL_MODE=baked
DPONE_PACKAGE_TARGET=/opt/dpone-runtime
DPONE_PROJECT_DIR=/opt/airflow/dags/repo
ENV_CODE=prod

DPONE_IT_MB_VAULT_PATH=api/mindbox
DPONE_IT_MB_SELECTORS=app.getactions
DPONE_IT_MB_DAYS_BACK=1
DPONE_IT_MB_SINCE_DATETIME_UTC=  # default: yesterday 12:00:00Z
DPONE_IT_MB_TILL_DATETIME_UTC=   # default: yesterday 13:00:00Z
DPONE_IT_MB_POLL_INTERVAL=30
DPONE_IT_MB_EXPORT_TIMEOUT=900
DPONE_IT_MB_BATCH_SIZE=1000
DPONE_IT_MB_UTC_BOUNDARY_TIME=21:00:00
