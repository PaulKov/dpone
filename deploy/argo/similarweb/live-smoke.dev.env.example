# Manual / live smoke in dev
DPONE_INSTALL_MODE=snapshot
DPONE_PACKAGE_SPEC=dpone[vault,gcp]==1.4.3.dev8123
DPONE_PACKAGE_INDEX_URL=https://<user>:<token>@gitlab.example.com/api/v4/projects/<project_id>/packages/pypi/simple
DPONE_PACKAGE_EXTRA_INDEX_URL=https://pypi.org/simple
DPONE_PACKAGE_TARGET=/opt/dpone-runtime
DPONE_PROJECT_DIR=/opt/airflow/dags/repo
ENV_CODE=dev

DPONE_IT_SW_VAULT_PATH=api/similarweb
DPONE_IT_SW_DOMAINS=travel.example.com
DPONE_IT_SW_SELECTORS=default.keywords
DPONE_IT_SW_RESOURCE=keywords
DPONE_IT_SW_LIMIT=5
DPONE_IT_SW_PAGE_SIZE=5
DPONE_IT_SW_MIN_KEYWORDS_COUNT=1
DPONE_IT_SW_TIMEOUT=60
DPONE_IT_SW_MAX_RETRIES=1
DPONE_IT_SW_RATE_LIMIT_DELAY=1.0
