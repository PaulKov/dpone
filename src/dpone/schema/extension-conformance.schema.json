{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dpone.dev/schemas/extension-conformance.schema.json",
  "title": "dpone extension conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "conformance_id", "profile", "subject", "status", "checks", "evaluated_at"],
  "properties": {
    "schema": {"const": "dpone.extension-conformance.v1"},
    "conformance_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile": {"enum": ["airflow_provider", "recipe_catalog", "credential_resolver", "route"]},
    "subject": {"$ref": "#/$defs/subject"},
    "status": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
    "checks": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/check"}},
    "evaluated_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "digest": {"$ref": "#/$defs/sha256"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["check", "status", "code", "artifact_ref", "sha256"], "properties": {"check": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "UNVERIFIED"]}, "code": {"type": "string"}, "artifact_ref": {"type": ["string", "null"]}, "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}}
  }
}
