{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulkov.github.io/dpone/schemas/selectors.schema.json",
  "title": "dpone named workload selectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "selectors"],
  "properties": {
    "schema": {"const": "dpone.selectors.v1"},
    "selectors": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9_.@/-]{0,127}$"},
      "additionalProperties": {"$ref": "#/$defs/selector"}
    }
  },
  "$defs": {
    "expression": {
      "type": "string",
      "minLength": 4,
      "maxLength": 256,
      "pattern": "^(?!.*(?:^|[:/])\\.\\.(?:/|$))(?:[+]?(?:id|tag|domain|owner|source|sink|group|selector):[A-Za-z0-9][A-Za-z0-9_.@/-]{0,127}[+]?|[+]?state:(?:modified|new|unmodified)[+]?)$"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["select"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "select": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/expression"}
        },
        "exclude": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/expression"}
        }
      }
    }
  }
}
