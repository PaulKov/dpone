{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paulkov.github.io/dpone/schemas/etl-flow-manifest.schema.json",
  "title": "dpone short flow authoring manifest",
  "description": "A short editable authoring source compiled into dpone.batch.v1 on the build plane.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "authoring", "metadata"],
  "allOf": [
    {
      "if": {"properties": {"authoring": {"properties": {"mode": {"const": "flow"}}}}},
      "then": {
        "oneOf": [
          {"required": ["processes"], "not": {"anyOf": [{"required": ["fragments"]}, {"required": ["recipe"]}]}},
          {
            "required": ["recipe"],
            "not": {"anyOf": [{"required": ["fragments"]}, {"required": ["processes"]}]},
            "properties": {
              "metadata": {
                "required": ["domain"],
                "properties": {"domain": {"pattern": "^[a-z][a-z0-9-]{0,62}$"}}
              }
            }
          }
        ]
      }
    },
    {
      "if": {"properties": {"authoring": {"properties": {"mode": {"const": "folder"}}}}},
      "then": {"required": ["fragments"], "not": {"anyOf": [{"required": ["processes"]}, {"required": ["recipe"]}]}}
    }
  ],
  "properties": {
    "gitops": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "airflow": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "resources": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "limits": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkMGTPE]|[KMGTPE]i)?$"
                    },
                    "ephemeral-storage": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkMGTPE]|[KMGTPE]i)?$"
                    },
                    "memory": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkMGTPE]|[KMGTPE]i)?$"
                    }
                  }
                },
                "requests": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkMGTPE]|[KMGTPE]i)?$"
                    },
                    "ephemeral-storage": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkMGTPE]|[KMGTPE]i)?$"
                    },
                    "memory": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkMGTPE]|[KMGTPE]i)?$"
                    }
                  }
                }
              },
              "description": "Base-container resources for runtime and separate hooks. Quote quantities; requests must not exceed limits. CPU precision is 1m; magnitude is at most 2^63-1 and precision at most 1n. Missing sections retain Kubernetes admission defaults."
            }
          }
        }
      }
    },
    "kind": {"const": "dpone.flow.v1"},
    "authoring": {"$ref": "#/definitions/authoring"},
    "metadata": {"$ref": "#/definitions/metadata"},
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/process"}
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$"
      }
    },
    "recipe": {"$ref": "#/definitions/recipe"},
    "quality": {"$ref": "#/definitions/managed_quality"},
    "observability": {"type": "object", "additionalProperties": true},
    "performance": {"type": "object", "additionalProperties": true},
    "certification": {"type": "object", "additionalProperties": true}
  },
  "definitions": {
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source"],
      "properties": {
        "mode": {"type": "string", "enum": ["flow", "folder"]},
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,127}$"},
        "domain": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "recipe": {"type": "string", "minLength": 1},
        "airflow": {
          "type": "boolean",
          "description": "Whether this workload participates in generated Airflow DAGs."
        },
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "quality_acceptance_column_selector": {
      "description": "Column selection for NULL or distinct acceptance metrics.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "off",
            "none",
            "all_columns",
            "business_columns",
            "source_and_binary_semantics",
            "strict"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "quality_acceptance_enabled_column_selector": {
      "allOf": [
        {
          "$ref": "#/definitions/quality_acceptance_column_selector"
        },
        {
          "not": {
            "enum": [
              false,
              "off",
              "none"
            ]
          }
        }
      ]
    },
    "quality_acceptance": {
      "type": "object",
      "title": "Pre-cleanup acceptance metric policy",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "warn_only",
            "required"
          ],
          "default": "warn_only"
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "source": {
              "type": "boolean",
              "default": true
            },
            "staged": {
              "type": "boolean",
              "default": true
            },
            "target": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "row_count": {
              "type": "boolean",
              "default": true
            },
            "null_counts": {
              "$ref": "#/definitions/quality_acceptance_column_selector",
              "default": "off"
            },
            "distinct_counts": {
              "$ref": "#/definitions/quality_acceptance_column_selector",
              "default": "off"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "capture": {
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "source"
                      ]
                    }
                  },
                  {
                    "required": [
                      "source"
                    ],
                    "properties": {
                      "source": {
                        "const": true
                      }
                    }
                  },
                  {
                    "not": {
                      "required": [
                        "staged"
                      ]
                    }
                  },
                  {
                    "required": [
                      "staged"
                    ],
                    "properties": {
                      "staged": {
                        "const": true
                      }
                    }
                  },
                  {
                    "not": {
                      "required": [
                        "target"
                      ]
                    }
                  },
                  {
                    "required": [
                      "target"
                    ],
                    "properties": {
                      "target": {
                        "const": true
                      }
                    }
                  }
                ]
              },
              "checks": {
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "row_count"
                      ]
                    }
                  },
                  {
                    "required": [
                      "row_count"
                    ],
                    "properties": {
                      "row_count": {
                        "const": true
                      }
                    }
                  },
                  {
                    "required": [
                      "null_counts"
                    ],
                    "properties": {
                      "null_counts": {
                        "$ref": "#/definitions/quality_acceptance_enabled_column_selector"
                      }
                    }
                  },
                  {
                    "required": [
                      "distinct_counts"
                    ],
                    "properties": {
                      "distinct_counts": {
                        "$ref": "#/definitions/quality_acceptance_enabled_column_selector"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "managed_quality": {
      "type": "object",
      "title": "Data quality contracts",
      "minProperties": 1,
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "acceptence",
            "accepance",
            "acceptancee"
          ]
        }
      },
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fail",
            "warn"
          ]
        },
        "acceptance": {
          "$ref": "#/definitions/quality_acceptance"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "type": "string",
                "enum": [
                  "fail",
                  "warn"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "min_rows"
                    }
                  }
                },
                "then": {
                  "propertyNames": {
                    "enum": [
                      "id",
                      "type",
                      "mode",
                      "severity",
                      "side",
                      "threshold",
                      "value"
                    ]
                  },
                  "anyOf": [
                    {
                      "required": [
                        "threshold"
                      ]
                    },
                    {
                      "required": [
                        "value"
                      ]
                    }
                  ],
                  "properties": {
                    "side": {
                      "type": "string",
                      "enum": [
                        "source",
                        "target"
                      ]
                    },
                    "threshold": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "source_target_count"
                    }
                  }
                },
                "then": {
                  "propertyNames": {
                    "enum": [
                      "id",
                      "type",
                      "mode",
                      "severity",
                      "tolerance_pct"
                    ]
                  },
                  "properties": {
                    "tolerance_pct": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            ]
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "accepted_values",
                  "custom_sql",
                  "freshness",
                  "min_rows",
                  "not_null",
                  "row_count_reconciliation",
                  "typed_hash_reconciliation",
                  "unique"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "side": {
                "type": "string",
                "enum": [
                  "source",
                  "target"
                ]
              },
              "threshold": {
                "type": "integer",
                "minimum": 0
              },
              "tolerance": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "absolute",
                      "pct"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "mode": {
                "type": "string",
                "enum": [
                  "full",
                  "sample"
                ]
              },
              "sql": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "min_rows"
                    }
                  }
                },
                "then": {
                  "required": [
                    "threshold"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "artifact_ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}@[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "artifact_ref": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "ref", "artifact_ref", "sha256"],
      "properties": {
        "catalog_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}@[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "artifact_ref": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "profile_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}@[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "parameters": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {"type": ["string", "integer", "number", "boolean", "null"]}
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "name"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "state_table_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "database": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "kafka_name": {"type": "string", "minLength": 1}
      }
    },
    "state_run_table_location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "run_name": {"type": "string", "minLength": 1, "deprecated": true}
      },
      "oneOf": [
        {"required": ["name"], "not": {"required": ["run_name"]}},
        {"required": ["run_name"], "not": {"required": ["name"]}}
      ]
    },
    "physical_design": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "apply_runtime": {
          "type": "boolean",
          "description": "Whether the workload runtime may apply physical DDL. False keeps the design declarative for externally provisioned objects.",
          "default": true
        },
        "columns": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "target_type": {
                "type": "object",
                "additionalProperties": {"type": "string"},
                "properties": {"mssql": {"type": "string"}}
              }
            }
          },
          "default": {}
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "connection_ref", "table"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "connection_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,126}[A-Za-z0-9])?$"
        },
        "table": {"$ref": "#/definitions/table"}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "source", "sink"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,127}$"},
        "source": {"$ref": "#/definitions/endpoint"},
        "sink": {
          "allOf": [
            {"$ref": "#/definitions/endpoint"},
            {
              "type": "object",
              "required": ["strategy"],
              "properties": {
                "strategy": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["mode"],
                  "properties": {
                    "mode": {"type": "string", "minLength": 1},
                    "unique_key": {
                      "oneOf": [
                        {"type": "string", "minLength": 1},
                        {
                          "type": "array",
                          "items": {"type": "string", "minLength": 1},
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if": {"properties": {"mode": {"const": "incremental_merge"}}},
                      "then": {"required": ["unique_key"]}
                    }
                  ]
                },
                "options": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "physical_design": {"$ref": "#/definitions/physical_design"}
                  }
                }
              }
            }
          ]
        },
        "depends_on": {"type": "array", "default": []},
        "transforms": {"type": "array", "default": []},
        "reconciliation": {
          "oneOf": [
            {"type": "boolean"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "mode", "cadence", "consistency", "delete_policy"],
              "properties": {
                "enabled": {"type": "boolean"},
                "mode": {"const": "key_snapshot"},
                "cadence": {"const": "every_run"},
                "consistency": {"const": "same_source_snapshot"},
                "delete_policy": {"const": "soft_delete"},
                "empty_snapshot": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["policy"],
                  "properties": {
                    "policy": {"const": "fail"}
                  }
                },
                "guards": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "max_delete_ratio": {"type": "number", "minimum": 0, "maximum": 1},
                    "max_delete_rows": {"type": "integer", "minimum": 0}
                  }
                }
              }
            }
          ]
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "oneOf": [
            {
              "properties": {"type": {"const": "disabled"}},
              "not": {"anyOf": [{"required": ["connection_ref"]}, {"required": ["reuse"]}]}
            },
            {
              "required": ["table"],
              "oneOf": [
                {"required": ["connection_ref"], "not": {"required": ["reuse"]}},
                {"required": ["reuse"], "not": {"required": ["connection_ref"]}},
                {
                  "required": ["connection_id"],
                  "not": {"anyOf": [{"required": ["connection_ref"]}, {"required": ["reuse"]}]}
                }
              ]
            }
          ],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "connection_ref": {"type": "string", "minLength": 1},
            "connection_id": {"type": "string", "minLength": 1, "deprecated": true},
            "connection_type": {"type": "string", "minLength": 1, "deprecated": true},
            "credentials_source": {"type": "string", "minLength": 1, "deprecated": true},
            "vault_mount_point": {"type": "string", "minLength": 1, "deprecated": true},
            "vault_path": {"type": "string", "minLength": 1, "deprecated": true},
            "reuse": {"type": "string", "const": "sink"},
            "atomicity": {"type": "string", "enum": ["after_target", "target_atomic"]},
            "provisioning": {"type": "string", "enum": ["runtime", "external"]},
            "table": {"$ref": "#/definitions/state_table_location"},
            "run_table": {"$ref": "#/definitions/state_run_table_location"},
            "receipt_table": {"$ref": "#/definitions/state_table_location"},
            "repair_authority_table": {"$ref": "#/definitions/state_table_location"},
            "repair_consumption_table": {"$ref": "#/definitions/state_table_location"},
            "audit_table": {"$ref": "#/definitions/state_table_location"}
          }
        },
        "quality": {"$ref": "#/definitions/managed_quality"},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visibility": {"type": "string", "enum": ["inline", "task", "group"], "default": "inline"}
          }
        }
      }
    }
  }
}
