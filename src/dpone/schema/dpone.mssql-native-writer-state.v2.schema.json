              "then": {
                "properties": {
                  "writer_proof_capability": {
                    "const": "bcp-supervised-stage-barrier-v1"
                  }
                }
              }
            }
          ],
          "properties": {
            "capability_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "grant_token_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "import_backend": {
              "enum": [
                "bcp",
                "mssql_sqlclient"
