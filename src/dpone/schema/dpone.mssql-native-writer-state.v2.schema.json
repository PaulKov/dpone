            "count_overflow",
            "diagnostic_code",
            "input_rows_consumed",
            "limbs",
            "quiescence",
            "row_count",
            "writer_outcome"
          ],
          "type": "object"
        }
      ]
    },
    "ordinal": {
      "minimum": 0,
      "type": "integer"
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      ]
