{
  "$id": "https://dpone.dev/schemas/dpone.mssql-native-writer-state.v2.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "previous_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "sequence": {
            "minimum": 1,
            "type": "integer"
          },
          "stage_binding": {
            "additionalProperties": false,
            "properties": {
              "object_id": {
                "minimum": 1,
                "type": "integer"
              },
              "owner_binding_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "schema_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "stage_id": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "object_id",
              "owner_binding_sha256",
              "schema_sha256",
              "stage_id"
            ],
            "type": "object"
          }
        }
      },
      "if": {
        "properties": {
          "event": {
            "const": "INTENT"
          }
        }
      },
      "then": {
        "properties": {
          "previous_sha256": {
            "type": "null"
          },
          "sequence": {
            "const": 0
          },
          "stage_binding": {
            "type": "null"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "writer_binding": {
            "additionalProperties": false,
            "allOf": [
              {
                "else": {
                  "properties": {
                    "writer_proof_capability": {
                      "const": "sqlclient-session-applock-v1"
                    }
                  }
                },
                "if": {
                  "properties": {
                    "import_backend": {
                      "const": "bcp"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "writer_proof_capability": {
                      "const": "bcp-supervised-stage-barrier-v1"
                    }
                  }
                }
              }
            ],
            "properties": {
              "capability_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "grant_token_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "import_backend": {
                "enum": [
                  "bcp",
                  "mssql_sqlclient"
                ]
              },
              "package_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "protocol_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "timeout_policy_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "writer_proof_capability": {
                "enum": [
                  "bcp-supervised-stage-barrier-v1",
                  "sqlclient-session-applock-v1"
                ]
              }
            },
            "required": [
              "capability_sha256",
              "grant_token_sha256",
              "import_backend",
              "package_sha256",
              "protocol_sha256",
              "timeout_policy_sha256",
              "writer_proof_capability"
            ],
            "type": "object"
          }
        }
      },
      "if": {
        "properties": {
          "event": {
            "enum": [
              "INTENT",
              "STAGE_OWNED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "writer_binding": {
            "type": "null"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "observation": {
            "additionalProperties": false,
            "properties": {
              "count_overflow": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "diagnostic_code": {
                "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "input_rows_consumed": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "minimum": 0,
                    "type": "integer"
                  }
                ]
              },
              "limbs": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "items": {
                      "pattern": "^(0|[1-9][0-9]*)$",
                      "type": "string"
                    },
                    "maxItems": 8,
                    "minItems": 8,
                    "type": "array"
                  }
                ]
              },
              "quiescence": {
                "enum": [
                  "unverified",
                  "proved",
                  "failed"
                ]
              },
              "row_count": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "minimum": 0,
                    "type": "integer"
                  }
                ]
              },
              "writer_outcome": {
                "enum": [
                  "cleanup_failed",
                  "custody_lost",
                  "failure",
                  "lost_ack",
                  "success",
                  "timeout"
                ]
              }
            },
            "required": [
              "count_overflow",
              "diagnostic_code",
              "input_rows_consumed",
              "limbs",
              "quiescence",
              "row_count",
              "writer_outcome"
            ],
            "type": "object"
          }
        }
      },
      "if": {
        "properties": {
          "event": {
            "enum": [
              "INTENT",
              "STAGE_OWNED",
              "GRANTED",
              "WRITING"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "type": "null"
          }
        }
      }
    }
