                  "maxItems": 8,
                  "minItems": 8,
                  "type": "array"
                }
              ]
            },
            "quiescence": {
              "enum": [
                "unverified",
                "proved",
                "failed"
              ]
            },
            "row_count": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "minimum": 0,
                  "type": "integer"
                }
              ]
