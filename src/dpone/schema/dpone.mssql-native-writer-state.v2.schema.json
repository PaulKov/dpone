    "event": {
      "enum": [
        "FAILED_RETIRABLE",
        "GRANTED",
        "INCIDENT_RETAINED",
        "INTENT",
        "PARTIAL_PROVED",
        "QUIESCENT",
        "RETIRED",
        "STAGE_OWNED",
        "UNKNOWN",
        "VERIFIED",
        "WRITER_TERMINAL",
        "WRITING"
