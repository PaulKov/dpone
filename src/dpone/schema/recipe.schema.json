{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paulkov.github.io/dpone/schemas/recipe.schema.json",
  "title": "dpone declarative recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "owner", "status", "domain", "parameter_schema", "override_allowlist", "profiles", "components"],
  "properties": {
    "schema": {"const": "dpone.recipe.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "status": {"enum": ["experimental", "stable", "deprecated"]},
    "description": {"type": "string", "maxLength": 1024},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "parameter_schema": {"$ref": "#/definitions/parameter_schema"},
    "override_allowlist": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}},
    "default_profile_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profiles": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/pin"}},
    "components": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/definitions/pin"}}
  },
  "definitions": {
    "parameter_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "type", "additionalProperties", "properties"],
      "properties": {
        "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "type": {"const": "object"},
        "additionalProperties": {"const": false},
        "properties": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_$-]{0,127}$"},
          "additionalProperties": {"$ref": "#/definitions/parameter"}
        },
        "required": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$-]{0,127}$"}
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "string", "integer", "number", "boolean",
            ["string", "null"], ["null", "string"],
            ["integer", "null"], ["null", "integer"],
            ["number", "null"], ["null", "number"],
            ["boolean", "null"], ["null", "boolean"]
          ]
        },
        "default": {},
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": ["string", "integer", "number", "boolean", "null"]}
        },
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0, "maximum": 1024},
        "x-dpone-format": {"enum": ["identifier", "connection_ref"]}
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "artifact_ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}@[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "artifact_ref": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
