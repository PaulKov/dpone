{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paulkov.github.io/dpone/schemas/profile.schema.json",
  "title": "dpone declarative recipe profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "owner", "status", "values", "locked_parameters"],
  "properties": {
    "schema": {"const": "dpone.profile.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "status": {"enum": ["experimental", "stable", "deprecated"]},
    "values": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {"type": ["string", "integer", "number", "boolean", "null"]}
    },
    "locked_parameters": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}}
  }
}
