{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dpone.dev/schemas/catalog-bundle.schema.json",
  "title": "dpone catalog bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "kind", "publisher_id", "environment", "entrypoint", "artifacts"],
  "properties": {
    "schema": {"const": "dpone.catalog-bundle.v1"},
    "bundle_id": {"$ref": "#/$defs/sha256"},
    "kind": {"enum": ["recipe_catalog", "connection_registry"]},
    "publisher_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "environment": {"type": ["string", "null"], "maxLength": 256},
    "entrypoint": {"type": "string", "pattern": "^payload/[A-Za-z0-9._/-]+$", "maxLength": 1024},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1001,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "path", "sha256", "size_bytes"],
      "properties": {
        "logical_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "path": {"type": "string", "pattern": "^payload/[A-Za-z0-9._/-]+$", "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 4194304}
      }
    }
  }
}
