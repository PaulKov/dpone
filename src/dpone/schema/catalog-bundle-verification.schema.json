{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dpone.dev/schemas/catalog-bundle-verification.schema.json",
  "title": "dpone catalog bundle verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision", "code", "bundle_id", "bundle_manifest_sha256", "kind", "publisher_id", "environment", "policy_fingerprint", "verified_artifacts", "verifier_version", "verified_at", "errors"],
  "properties": {
    "schema": {"const": "dpone.catalog-bundle-verification.v1"},
    "decision": {"enum": ["verified", "invalid", "unverified"]},
    "code": {"type": "string", "minLength": 1},
    "bundle_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "kind": {"type": ["string", "null"]},
    "publisher_id": {"type": ["string", "null"]},
    "environment": {"type": ["string", "null"]},
    "policy_fingerprint": {"$ref": "#/$defs/sha256"},
    "verified_artifacts": {"type": "integer", "minimum": 0, "maximum": 1001},
    "verifier_version": {"type": ["string", "null"]},
    "verified_at": {"type": "string", "minLength": 1},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}
    }
  }
}
