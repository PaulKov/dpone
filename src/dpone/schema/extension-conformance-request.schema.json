{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dpone.dev/schemas/extension-conformance-request.schema.json",
  "title": "dpone extension conformance request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "subject", "evidence"],
  "properties": {
    "schema": {"const": "dpone.extension-conformance-request.v1"},
    "profile": {"enum": ["airflow_provider", "recipe_catalog", "credential_resolver", "route"]},
    "subject": {"$ref": "#/$defs/subject"},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/sha256"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["check", "artifact_ref", "sha256", "expected_schema"],
      "properties": {"check": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "expected_schema": {"enum": ["dpone.extension-check-receipt.v1", "dpone.catalog-bundle-verification.v1"]}}
    }
  }
}
